# ============================================
# AbiaWay Transit System — Environment Template
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env files to version control.

# ABSIN API Configuration
VITE_ABSIN_API_URL=https://api.absin.abia.gov.ng/v1
VITE_ABSIN_API_KEY=your-api-key-here
VITE_ABSIN_MERCHANT_ID=your-merchant-id-here
VITE_ENABLE_ABSIN=true
VITE_ABSIN_MOCK_MODE=true

# Demo credentials (development only — change before production)
VITE_DEMO_ADMIN_PASSWORD=change-me
VITE_DEMO_DRIVER_PASSWORD=change-me
VITE_DEMO_PASSENGER_PASSWORD=change-me
VITE_DEMO_GOLD_PASSWORD=change-me

# Demo tokens (development only)
VITE_DEMO_AUTH_TOKEN=change-me
VITE_MOCK_JWT_TOKEN=change-me
VITE_DEMO_ABSIN_API_KEY=change-me
VITE_DEMO_ABSIN_PIN=change-me

# Demo bank card data (JSON, development only)
# VITE_DEMO_ABSIN_CARDS={"1234567890123456":{"cardholder":"Abuoma David","balance":12450,"tier":"Premium"}}
# VITE_DEMO_BANK_CARDS={"4111111111111111":{"type":"visa","cardholder":"Abuoma David","balance":25000,"expiry":"12/28","cvv":"123","status":"active"}}

# Paystack (wallet funding). Get a key from https://dashboard.paystack.com/#/settings/developers
# Leave empty to use the demo simulation mode.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Cloudflare Worker that verifies Paystack payments (see worker/ folder).
# Deployed via `npx wrangler deploy` inside worker/. Set after deploy.
VITE_PAYSTACK_VERIFY_URL=https://abiaway-paystack-verify.YOUR-SUBDOMAIN.workers.dev

# Secret key for the Cloud Function (functions/index.js): set it with
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
# NEVER put the secret in a VITE_ variable — it ships to the browser.
# PAYSTACK_SECRET_KEY=

# Ticket QR signing key (client-side HMAC). For real fare validation,
# move signing to a Cloud Function and share the secret out-of-band.
VITE_TICKET_SIGNING_KEY=change-me
