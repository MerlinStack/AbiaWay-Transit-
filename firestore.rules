rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — only the owning user or admins can read/write.
    // role is immutable by the user: prevents self-promotion to admin.
    // adminKeyHash is immutable except a one-time bootstrap on an existing
    // admin profile, so admin access keys can only be vetted/issued externally.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'admin');
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.role == 'passenger';
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && (request.resource.data.adminKeyHash == resource.data.adminKeyHash
            || (resource.data.role == 'admin' && !('adminKeyHash' in resource.data)));
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Staff badges — readable by any authenticated user (required for badge
    // sign-in verification). Writes are disabled client-side: badges can only
    // be issued, updated, or deactivated by an administrator with the Admin
    // SDK, which is what makes staff access vetted rather than self-served.
    match /staffBadges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Buses — readable by everyone, writable by drivers and admins
    match /buses/{busId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'driver');
    }

    // Routes — readable by everyone, writable by admins
    match /routes/{routeId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Bookings — users can read/write their own; admins can read all
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow create: if request.auth != null;
    }

    // Transactions — users can read their own
    match /transactions/{txnId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.token.role == 'admin');
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Wallets — users read their own balance; server (Admin SDK) writes
    match /wallets/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
      allow write: if false;
    }

    // Wallet credits ledger — users read their own records; server (Admin SDK) writes
    match /walletCredits/{reference} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.token.role == 'admin');
      allow write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
